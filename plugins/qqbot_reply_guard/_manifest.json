{
  "manifest_version": 2,
  "id": "mlj.qqbot-reply-guard",
  "version": "0.1.0",
  "name": "QQBot 公开答复",
  "description": "直接发送已经写好的公开答复，允许先发送可靠阶段结论再继续研究。",
  "author": {"name": "MLJ", "url": "https://github.com/MengLeiFudge"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/MengLeiFudge/qqbot"},
  "host_application": {"min_version": "1.2.3", "max_version": "1.2.3"},
  "sdk": {"min_version": "2.8.0", "max_version": "2.99.99"},
  "dependencies": [
    {"type": "plugin", "id": "mlj.qqbot-identity", "version_spec": ">=0.1.1,<0.2.0"},
    {"type": "plugin", "id": "mlj.qqbot-knowledge", "version_spec": ">=0.2.1,<0.3.0"}
  ],
  "capabilities": ["config.get", "message.get_recent", "chat.get_stream_by_user_id", "chat.get_stream_by_group_id", "send.text"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "plugin_type": "extension"
}
