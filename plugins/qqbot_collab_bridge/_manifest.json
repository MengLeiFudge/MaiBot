{
  "manifest_version": 2,
  "id": "mlj.qqbot-collab-bridge",
  "version": "0.1.0",
  "name": "QQBot Pi协作桥接",
  "description": "默认禁用的Pi协作对等插件，分群攒批、私聊决定与限定回传。",
  "author": {"name": "MLJ", "url": "https://github.com/MengLeiFudge"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/MengLeiFudge/qqbot"},
  "host_application": {"min_version": "1.1.0", "max_version": "1.1.99"},
  "sdk": {"min_version": "2.7.0", "max_version": "2.99.99"},
  "dependencies": [
    {"type": "plugin", "id": "mlj.qqbot-common", "version_spec": ">=0.1.2,<1.0.0"},
    {"type": "plugin", "id": "maibot-team.napcat-adapter", "version_spec": ">=1.3.2,<2.0.0"}
  ],
  "capabilities": ["api.call", "llm.generate"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "plugin_type": "extension"
}
