{
  "manifest_version": 2,
  "id": "org.orge-8.better-diary",
  "version": "1.9.0",
  "name": "better-diary 日记插件",
  "description": "睡前日记：两阶段生成（先给当天聊天选材打分，再据精选事件成文），刻意反 AI 腔，成品只发 QQ 空间，聊天里仅回报状态。功能含定时生成（重启不丢当天）、缺档补写、本地检索；选材兼顾分数与人物/题材多样性（同人最多 2 件、群趣闻可回填），篇幅按素材量分短中长三档；天气与归档术语以当天原文为据，线索不足时只按氛围选。权限 fail-closed：先配 admin_ids 才可用。",
  "author": {
    "name": "orge-8",
    "url": "https://github.com/orge-8"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/orge-8/better-diary"
  },
  "host_application": {
    "min_version": "1.2.3",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.21.0"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27"
    }
  ],
  "capabilities": [
    "send.text",
    "api.call",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.get_group_streams",
    "chat.get_all_streams",
    "message.get_by_time",
    "message.get_by_time_in_chat",
    "llm.generate",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
