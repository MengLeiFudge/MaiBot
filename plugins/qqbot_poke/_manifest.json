{
  "manifest_version": 2,
  "id": "mlj.qqbot-poke",
  "version": "0.1.3",
  "name": "QQBot 戳一戳",
  "description": "MaiBot 原生拍一拍状态机、受控反拍和短时禁言插件。",
  "author": {
    "name": "MLJ",
    "url": "https://github.com/MengLeiFudge"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/MengLeiFudge/qqbot",
    "homepage": "https://github.com/MengLeiFudge/qqbot",
    "issues": "https://github.com/MengLeiFudge/qqbot/issues"
  },
  "host_application": {
    "min_version": "1.1.0",
    "max_version": "1.2.3"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "plugin",
      "id": "maibot-team.napcat-adapter",
      "version_spec": ">=1.3.2,<2.0.0"
    }
  ],
  "capabilities": ["api.call", "config.get", "llm.generate", "send.text"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "plugin_type": "extension"
}
