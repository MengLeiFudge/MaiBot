{
  "manifest_version": 2,
  "id": "mlj.qqbot-draw",
  "version": "0.2.0",
  "name": "QQBot RightCodes 生图",
  "description": "MaiBot 原生生图、积分、排行和模型切换插件。",
  "author": {
    "name": "MLJ",
    "url": "https://github.com/MengLeiFudge"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/MengLeiFudge/qqbot",
    "homepage": "https://github.com/MengLeiFudge/qqbot",
    "issues": "https://github.com/MengLeiFudge/qqbot/issues"
  },
  "host_application": {
    "min_version": "1.1.0",
    "max_version": "1.1.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "plugin",
      "id": "mlj.qqbot-common",
      "version_spec": ">=0.1.2,<1.0.0"
    },
    {
      "type": "plugin",
      "id": "maibot-team.napcat-adapter",
      "version_spec": ">=1.3.2,<2.0.0"
    }
  ],
  "capabilities": ["api.call", "send.text", "llm.generate"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "plugin_type": "extension"
}
