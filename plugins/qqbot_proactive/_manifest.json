{
  "manifest_version": 2,
  "id": "mlj.qqbot-proactive",
  "version": "0.3.1",
  "name": "QQBot 私聊主动续聊",
  "description": "为主人私聊安排一次后续联系，按话题选择检查时机，通过原生 Maisaka 自然续聊。",
  "author": {"name": "MLJ", "url": "https://github.com/MengLeiFudge"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/MengLeiFudge/qqbot",
    "homepage": "https://github.com/MengLeiFudge/qqbot",
    "issues": "https://github.com/MengLeiFudge/qqbot/issues"
  },
  "host_application": {"min_version": "1.2.3", "max_version": "1.2.3"},
  "sdk": {"min_version": "2.8.0", "max_version": "2.99.99"},
  "dependencies": [{"type": "plugin", "id": "mlj.qqbot-identity", "version_spec": ">=0.1.0,<0.2.0"}],
  "capabilities": ["config.get", "config.get_plugin", "chat.get_stream_by_user_id", "message.get_recent", "message.get_by_id", "llm.generate", "maisaka.proactive.trigger"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "plugin_type": "extension"
}
