{
  "manifest_version": 2,
  "id": "mlj.qqbot-visual",
  "version": "0.3.0",
  "name": "QQBot 定向看图",
  "description": "保留群聊图片门控、本地表情和私聊原图能力，下载视频链接或附件生成分镜描述。",
  "author": {"name": "MLJ", "url": "https://github.com/MengLeiFudge"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/MengLeiFudge/qqbot",
    "homepage": "https://github.com/MengLeiFudge/qqbot",
    "issues": "https://github.com/MengLeiFudge/qqbot/issues"
  },
  "host_application": {"min_version": "1.2.3", "max_version": "1.2.3"},
  "sdk": {"min_version": "2.8.0", "max_version": "2.99.99"},
  "dependencies": [
    {"type": "python_package", "name": "Pillow", "version_spec": ">=11.3,<13"},
    {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.8"},
    {"type": "python_package", "name": "yt-dlp", "version_spec": ">=2025.10.14"},
    {"type": "python_package", "name": "ffmpeg-binaries", "version_spec": "==1.1.0"},
    {"type": "plugin", "id": "maibot-team.napcat-adapter", "version_spec": ">=1.3.4,<2.0.0"}
  ],
  "capabilities": ["config.get", "message.get_by_id", "message.get_recent", "api.call", "llm.generate"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "plugin_type": "extension"
}
