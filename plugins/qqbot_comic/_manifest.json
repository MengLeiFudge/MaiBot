{
  "manifest_version": 2,
  "id": "mlj.qqbot-comic",
  "version": "0.1.0",
  "name": "QQBot JM Comic PDF",
  "description": "MaiBot 原生 JM 漫画下载、PDF 缓存、加密切片和好友私聊交付插件。",
  "author": {"name": "MLJ", "url": "https://github.com/MengLeiFudge"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/MengLeiFudge/qqbot",
    "homepage": "https://github.com/MengLeiFudge/qqbot",
    "issues": "https://github.com/MengLeiFudge/qqbot/issues"
  },
  "host_application": {"min_version": "1.1.0", "max_version": "1.1.99"},
  "sdk": {"min_version": "2.7.0", "max_version": "2.99.99"},
  "dependencies": [
    {"type": "plugin", "id": "mlj.qqbot-common", "version_spec": ">=0.1.2,<1.0.0"},
    {"type": "plugin", "id": "maibot-team.napcat-adapter", "version_spec": ">=1.3.3,<2.0.0"},
    {"type": "python_package", "name": "jmcomic", "version_spec": "==2.7.2"},
    {"type": "python_package", "name": "img2pdf", "version_spec": "==0.6.1"},
    {"type": "python_package", "name": "pikepdf", "version_spec": "==10.11.0"}
  ],
  "capabilities": ["api.call", "send.text"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "plugin_type": "extension"
}
